7 \u092d\u0915\u094d\u0924\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0917\u093e\u090f \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u092d\u0915\u094d\u0924\u093f \u0917\u0940\u0924\u094b\u0902 \u0915\u094b \u0915\u094d\u092f\u093e \u0915\u0939\u093e \u091c\u093e\u0924\u093e \u0939\u0948?\n[4th Grade 6th Phase) 21.09.2025]", "sectionId": "6a780e07d929233c36dbe0ce", "order": 5, "questionSubmitOrder": 5, "options": [{"name": "<p style=\"text-decoration: none\">\n <span style=\"color: #000000\"><span style=\"font-family: Calibri\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans'\">\u0939\u092e\u0938\u0940\u0926\u094b</span></span></span></span></p>\n ", "nameText": "\n \u0939\u092e\u0938\u0940\u0926\u094b\n ", "isCorrect": false, "_id": "6904bc368c5f113b0d2d813e", "isMarked": false}, {"name": "<p style=\"text-decoration: none\">\n <span style=\"color: #000000\"><span style=\"font-family: Calibri\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans'\">\u0932\u093e\u0902\u0917\u0941\u0930\u093f\u092f\u093e</span></span></span></span></p>\n ", "nameText": "\n \u0932\u093e\u0902\u0917\u0941\u0930\u093f\u092f\u093e\n ", "isCorrect": true, "_id": "6904bc368c5f1121e92d813f", "isMarked": false}, {"name": "<p style=\"text-decoration: none\">\n <span style=\"color: #000000\"><span style=\"font-family: Calibri\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans'\">\u0932\u093e\u0932\u0930</span></span></span></span></p>\n ", "nameText": "\n \u0932\u093e\u0932\u0930\n ", "isCorrect": false, "_id": "6904bc368c5f116d0c2d8140", "isMarked": false}, {"name": "<p style=\"text-decoration: none\">\n <span style=\"color: #000000\"><span style=\"font-family: Calibri\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans'\">\u092a\u0928\u093f\u0939\u093e\u0930\u0940</span></span></span><span style=\"font-family: Calibri,serif\"><span style=\"font-family: 'Noto Sans',serif\">/</span></span><span style=\"font-family: Calibri\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans'\">\u092a\u0923\u093f\u0939\u093e\u0930\u0940</span></span></span></span></p>\n ", "nameText": "\n \u092a\u0928\u093f\u0939\u093e\u0930\u0940/\u092a\u0923\u093f\u0939\u093e\u0930\u0940\n ", "isCorrect": false, "_id": "6904bc368c5f110fad2d8141", "isMarked": false}], "solution": "<h3>\ud83d\udd39 <strong>\u0935\u094d\u092f\u093e\u0916\u094d\u092f\u093e</strong></h3>\n<p>\ud83d\udc49 <strong>\u0932\u093e\u0902\u0917\u0941\u0930\u093f\u092f\u093e \u0917\u0940\u0924</strong> \u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u0915\u0947 <strong>\u0915\u0930\u094c\u0932\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930</strong> \u092e\u0947\u0902 \u0926\u0947\u0935\u0940 <strong>\u0915\u0948\u0932\u093e \u0926\u0947\u0935\u0940</strong> \u0915\u0940 \u0906\u0930\u093e\u0927\u0928\u093e \u092e\u0947\u0902 \u0917\u093e\u090f \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 <strong>\u092d\u0915\u094d\u0924\u093f \u0917\u0940\u0924</strong> \u0939\u0948\u0902\u0964<br />\ud83d\udc49 \u092f\u0947 \u0917\u0940\u0924 \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0947 <strong>\u0928\u0935\u0930\u093e\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0905\u0935\u0938\u0930 \u092a\u0930</strong> \u0917\u093e\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902, \u091c\u092c <strong>\u0915\u0948\u0932\u093e \u0926\u0947\u0935\u0940 \u092e\u0902\u0926\u093f\u0930 \u092e\u0947\u0902 \u0935\u093f\u0936\u093e\u0932 \u092e\u0947\u0932\u093e</strong> \u0906\u092f\u094b\u091c\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964<br />\ud83d\udc49 \u0907\u0928\u094d\u0939\u0947\u0902 <strong>\u0915\u0948\u0932\u093e \u0926\u0947\u0935\u0940 \u0915\u0947 \u092d\u0915\u094d\u0924\u094b\u0902</strong> \u0926\u094d\u0935\u093e\u0930\u093e <strong>\u092d\u0915\u094d\u0924\u093f \u0914\u0930 \u0909\u0924\u094d\u0938\u093e\u0939</strong> \u0915\u0947 \u0938\u093e\u0925 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964<br />\ud83d\udc49 \u0907\u0928 \u0917\u0940\u0924\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 <strong>\u0932\u093e\u0902\u0917\u0941\u0930\u093f\u092f\u093e \u0928\u0943\u0924\u094d\u092f</strong> \u092d\u0940 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u094b <strong>\u092d\u0915\u094d\u0924\u093f \u0914\u0930 \u0906\u0928\u0902\u0926 \u0915\u093e \u0938\u093e\u092e\u0942\u0939\u093f\u0915 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928</strong> \u0939\u094b\u0924\u093e \u0939\u0948\u0964<br />\ud83d\udc49 \u092f\u0939 \u092a\u0930\u0902\u092a\u0930\u093e <strong>\u0915\u0930\u094c\u0932\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0940 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0906\u0938\u094d\u0925\u093e \u0914\u0930 \u0932\u094b\u0915\u092d\u0915\u094d\u0924\u093f</strong> \u0915\u093e \u092a\u094d\u0930\u0924\u0940\u0915 \u0939\u0948\u0964</p>\n<p></p>\n<p>\u270d\ufe0f \u0938\u0939\u0940 \u0909\u0924\u094d\u0924\u0930 \u0939\u0948 &ndash; <strong>\u0932\u093e\u0902\u0917\u0941\u0930\u093f\u092f\u093e&nbsp;</strong></p>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": false, "isPartiallyCorrect": false, "isCorrect": false, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6ac94e923198c95c889e1b96", "marks": {"positive": 0, "negative": 0}, "timeTaken": 0, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null}]}