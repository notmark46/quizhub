u091b\u0932\u0940 \u092a\u094d\u0930\u091c\u0928\u0928 \u0915\u0947\u0902\u0926\u094d\u0930</strong> \u091f\u094b\u0902\u0915 \u091c\u093f\u0932\u0947 \u0915\u0947 <strong>\u092c\u0940\u0938\u0932\u092a\u0941\u0930 \u092c\u093e\u0902\u0927</strong> \u092a\u0930 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948, \u091c\u0939\u093e\u0901 \u092e\u0940\u0920\u0947 \u092a\u093e\u0928\u0940 \u0915\u0940 \u0930\u0902\u0917\u0940\u0928 \u092e\u091b\u0932\u093f\u092f\u094b\u0902 \u0915\u093e <strong>\u0935\u093f\u0936\u0947\u0937 \u092a\u094d\u0930\u091c\u0928\u0928</strong> \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964<br />\ud83d\udc49 \u0907\u0938 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u093e \u092e\u0941\u0916\u094d\u092f \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f <strong>\u0938\u091c\u093e\u0935\u091f\u0940 \u092e\u091b\u0932\u093f\u092f\u094b\u0902</strong> \u0915\u0947 \u092a\u094d\u0930\u091c\u0928\u0928 \u0915\u094b \u092c\u0922\u093c\u093e\u0935\u093e \u0926\u0947\u0928\u093e \u0924\u0925\u093e \u0930\u093e\u091c\u094d\u092f \u092e\u0947\u0902 \u0907\u0938 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0940 <strong>\u0909\u0924\u094d\u092a\u093e\u0926\u0915 \u0915\u094d\u0937\u092e\u0924\u093e</strong> \u0915\u094b \u0938\u0941\u0926\u0943\u0922\u093c \u0915\u0930\u0928\u093e \u0939\u0948\u0964<br />\ud83d\udc49 \u0915\u0947\u0902\u0926\u094d\u0930 \u092e\u0947\u0902 \u0932\u0917\u092d\u0917 <strong>50 \u092a\u094d\u0930\u091c\u093e\u0924\u093f\u092f\u094b\u0902</strong> \u0915\u0940 \u0930\u0902\u0917\u0940\u0928 \u092e\u0940\u0920\u0947 \u092a\u093e\u0928\u0940 \u0915\u0940 \u092e\u091b\u0932\u093f\u092f\u093e\u0901 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0940 \u0917\u0908 \u0939\u0948\u0902, \u091c\u092c\u0915\u093f 10&ndash;12 \u092a\u094d\u0930\u091c\u093e\u0924\u093f\u092f\u094b\u0902 \u0915\u093e \u0928\u093f\u092f\u092e\u093f\u0924 <strong>\u092a\u094d\u0930\u091c\u0928\u0928 \u0915\u093e\u0930\u094d\u092f</strong> \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948\u0964<br />\ud83d\udc49 \u092f\u0939 \u0907\u0915\u093e\u0908 \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0924\u0925\u093e \u0917\u094d\u0930\u093e\u092e\u0940\u0923 \u0932\u094b\u0917\u094b\u0902 \u0915\u094b <strong>\u092e\u091b\u0932\u0940 \u092a\u093e\u0932\u0928 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923</strong> \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0940 \u0939\u0948, \u091c\u093f\u0938\u0938\u0947 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092f\u0941\u0935\u093e\u0913\u0902 \u092e\u0947\u0902 <strong>\u0930\u094b\u091c\u093c\u0917\u093e\u0930 \u0905\u0935\u0938\u0930</strong> \u0935\u093f\u0915\u0938\u093f\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964<br />\ud83d\udc49 \u092f\u0939 \u0915\u0947\u0902\u0926\u094d\u0930 \u092c\u0940\u0938\u0932\u092a\u0941\u0930 \u092c\u093e\u0902\u0927 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 <strong>\u092a\u0930\u094d\u092f\u091f\u0928 \u092c\u0922\u093c\u093e\u0928\u0947</strong> \u092e\u0947\u0902 \u092d\u0940 \u0938\u0939\u093e\u092f\u0915 \u0938\u093f\u0926\u094d\u0927 \u0939\u094b \u0930\u0939\u093e \u0939\u0948 \u0914\u0930 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u0935\u093f\u0915\u093e\u0938 \u0915\u094b \u092a\u094d\u0930\u094b\u0924\u094d\u0938\u093e\u0939\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964</p>\n<p></p>\n<p>\u270d\ufe0f \u0938\u0939\u0940 \u0909\u0924\u094d\u0924\u0930 \u0939\u0948 &ndash; <strong>\u092c\u0940\u0938\u0932\u092a\u0941\u0930 \u092c\u093e\u0902\u0927&nbsp;&nbsp;</strong></p>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": false, "isPartiallyCorrect": false, "isCorrect": false, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6aca50a121ced820a1d7b85d", "marks": {"positive": 0, "negative": 0}, "timeTaken": 0, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null, "year": "2025"}]}