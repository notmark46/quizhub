939\u093e\u0930 \u0935\u0902\u0936</strong> \u0915\u093e <strong>\u0938\u0902\u0938\u094d\u0925\u093e\u092a\u0915</strong> \u0925\u093e, \u091c\u093f\u0938\u0915\u0940 \u0930\u093e\u091c\u0927\u093e\u0928\u0940 <strong>\u0915\u0928\u094d\u0928\u094c\u091c</strong> \u0925\u0940\u0964<br />\ud83d\udc49 <strong>\u0935\u0932\u094d\u0932\u092d\u0930\u093e\u091c</strong> \u0914\u0930 <strong>\u0928\u093e\u0917\u092d\u091f\u094d\u091f \u0926\u094d\u0935\u093f\u0924\u0940\u092f</strong> \u0928\u0947 \u0938\u093e\u092e\u094d\u0930\u093e\u091c\u094d\u092f \u0915\u0940 <strong>\u0938\u0941\u0926\u0943\u0922\u093c\u0924\u093e</strong> \u0914\u0930 <strong>\u0935\u093f\u0938\u094d\u0924\u093e\u0930</strong> \u092e\u0947\u0902 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u092d\u0942\u092e\u093f\u0915\u093e \u0928\u093f\u092d\u093e\u0908\u0964<br />\ud83d\udc49 <strong>\u092e\u093f\u0939\u093f\u0930 \u092d\u094b\u091c</strong> \u0907\u0938 \u0935\u0902\u0936 \u0915\u093e <strong>\u0938\u092c\u0938\u0947 \u0936\u0915\u094d\u0924\u093f\u0936\u093e\u0932\u0940 \u0936\u093e\u0938\u0915</strong> \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0915\u0947 \u0936\u093e\u0938\u0928 \u092e\u0947\u0902 \u0938\u093e\u092e\u094d\u0930\u093e\u091c\u094d\u092f <strong>\u0915\u093e\u092c\u0941\u0932\u0935\u093e\u0921\u093c\u0940 \u0938\u0947 \u092c\u093f\u0939\u093e\u0930</strong> \u0914\u0930 <strong>\u0915\u0936\u094d\u092e\u0940\u0930 \u0938\u0947 \u0928\u0930\u094d\u092e\u0926\u093e</strong> \u0924\u0915 \u092b\u0948\u0932\u093e\u0964<br />\ud83d\udc49 <strong>\u092e\u0939\u0947\u0902\u0926\u094d\u0930\u092a\u093e\u0932</strong> \u0928\u0947 \u0905\u092a\u0928\u0947 \u0930\u093e\u091c\u094d\u092f \u0915\u094b <strong>\u092c\u0902\u0917\u093e\u0932</strong> \u0914\u0930 <strong>\u092e\u0917\u0927</strong> \u0924\u0915 \u092c\u0922\u093c\u093e\u092f\u093e, \u091c\u093f\u0938\u0938\u0947 \u092a\u094d\u0930\u0924\u093f\u0939\u093e\u0930\u094b\u0902 \u0915\u0940 \u0936\u0915\u094d\u0924\u093f \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093e \u0914\u0930 \u092d\u0940 \u092c\u0922\u093c\u0940\u0964<br />\ud83d\udc49 \u092a\u094d\u0930\u0924\u093f\u0939\u093e\u0930 \u0935\u0902\u0936 \u0928\u0947 <strong>8\u0935\u0940\u0902 \u0938\u0947 11\u0935\u0940\u0902 \u0936\u0924\u093e\u092c\u094d\u0926\u0940</strong> \u0915\u0947 \u092c\u0940\u091a \u0909\u0924\u094d\u0924\u0930\u0940 \u0914\u0930 \u092a\u0936\u094d\u091a\u093f\u092e\u0940 \u092d\u093e\u0930\u0924 \u092a\u0930 \u0936\u093e\u0938\u0928 \u0915\u093f\u092f\u093e \u0924\u0925\u093e <strong>\u0935\u093f\u0926\u0947\u0936\u0940 \u0906\u0915\u094d\u0930\u092e\u0923\u094b\u0902</strong> \u0938\u0947 \u092d\u093e\u0930\u0924 \u0915\u0940 \u0930\u0915\u094d\u0937\u093e \u0915\u0940\u0964</p>\n<p lang=\"en-US\"></p>\n<p>\u270d\ufe0f \u0938\u0939\u0940 \u0909\u0924\u094d\u0924\u0930 \u0939\u0948 &ndash;&nbsp;<strong><span style=\"color: #000000; font-family: Calibri;\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans';\">\u0928\u093e\u0917\u092d\u091f\u094d\u091f&nbsp;</span></span></span><span style=\"color: #000000; font-family: Calibri, serif;\"><span style=\"font-family: 'Noto Sans', serif;\">I&nbsp;</span></span></strong></p>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": false, "isPartiallyCorrect": false, "isCorrect": false, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6ac8f6cf2e496c082bc356a6", "marks": {"positive": 0, "negative": 0}, "timeTaken": 0, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null}]}