u093f\u092e\u093f\u091f\u0947\u0921) \u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u0915\u093e \u092a\u094d\u0930\u092e\u0941\u0916 \u0926\u0941\u0917\u094d\u0927 \u0938\u0939\u0915\u093e\u0930\u0940 \u0938\u0902\u0918 \u0939\u0948\u0964</li>\n<li style=\"text-decoration: none;\">\u092f\u0939 \u0930\u093e\u091c\u094d\u092f \u092e\u0947\u0902 '\u0938\u0930\u0938' (Saras) \u092c\u094d\u0930\u093e\u0902\u0921 \u0915\u0947 \u0924\u0939\u0924 \u0926\u0942\u0927 \u0914\u0930 \u0921\u0947\u092f\u0930\u0940 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0915\u093e \u0935\u093f\u092a\u0923\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964</li>\n<li style=\"text-decoration: none;\">\u0907\u0938\u0915\u0940 \u0938\u094d\u0925\u093e\u092a\u0928\u093e 1977 \u092e\u0947\u0902 \u0939\u0941\u0908 \u0925\u0940 \u0914\u0930 \u0907\u0938\u0915\u093e \u092e\u0941\u0916\u094d\u092f\u093e\u0932\u092f \u091c\u092f\u092a\u0941\u0930 \u092e\u0947\u0902 \u0938\u094d\u0925\u093f\u0924 \u0939\u0948\u0964</li>\n<li style=\"text-decoration: none;\">\u092a\u094d\u0930\u092e\u0941\u0916 \u092c\u093f\u0902\u0926\u0941:\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f: 1.\u0915\u093f\u0938\u093e\u0928\u094b\u0902 \u0914\u0930 \u092a\u0936\u0941\u092a\u093e\u0932\u0915\u094b\u0902 \u0938\u0947 \u0926\u0942\u0927 \u090f\u0915\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0915\u0947 \u0909\u0938\u0947 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u0915\u0930\u0928\u093e \u0914\u0930 \u0909\u092a\u092d\u094b\u0915\u094d\u0924\u093e\u0913\u0902 \u0924\u0915 \u0936\u0941\u0926\u094d\u0927 \u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0939\u0941\u0901\u091a\u093e\u0928\u093e\u0964</li>\n<li style=\"text-decoration: none;\">\u092c\u094d\u0930\u093e\u0902\u0921: \u0938\u0930\u0938 (Saras) \u092c\u094d\u0930\u093e\u0902\u0921 \u0915\u0947 \u0905\u0902\u0924\u0930\u094d\u0917\u0924 \u0926\u0942\u0927, \u0918\u0940, \u092a\u0928\u0940\u0930, \u091b\u093e\u091b, \u0914\u0930 \u0932\u0938\u094d\u0938\u0940 \u091c\u0948\u0938\u0947 \u0909\u0924\u094d\u092a\u093e\u0926 \u092c\u0947\u091a\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964</li>\n<li style=\"text-decoration: none;\">\u0935\u093f\u0938\u094d\u0924\u093e\u0930: \u0939\u093e\u0932 \u0939\u0940 \u092e\u0947\u0902 RCDF \u0928\u0947 '\u0938\u0930\u0938 \u0928\u0940\u0930' (\u092a\u0948\u0915\u0947\u091c\u094d\u0921 \u0921\u094d\u0930\u093f\u0902\u0915\u093f\u0902\u0917 \u0935\u0949\u091f\u0930) \u092d\u0940 \u0932\u0949\u0928\u094d\u091a \u0915\u093f\u092f\u093e \u0939\u0948\u0964</li>\n<li style=\"text-decoration: none;\">\u0906\u0927\u0941\u0928\u093f\u0915 \u0906\u0909\u091f\u0932\u0947\u091f\u094d\u0938: \u0930\u093e\u091c\u094d\u092f \u092e\u0947\u0902 \u0906\u0927\u0941\u0928\u093f\u0915 \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0935\u093e\u0932\u0947 '\u0938\u0930\u0938 \u0915\u0948\u092b\u0947 \u0914\u0930 \u0906\u0909\u091f\u0932\u0947\u091f\u094d\u0938' \u0915\u093e \u0935\u093f\u0938\u094d\u0924\u093e\u0930 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948\u0964</li>\n</ul>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": true, "isPartiallyCorrect": false, "isCorrect": true, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6aca4f123330228843214c80", "marks": {"positive": 2, "negative": 0}, "timeTaken": 9000, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null, "year": "2019"}, {"_id": "66b0a1da2c1fbc4d2f1cac74", "name": "<p class=\"western\"><span style=\"font-family: 'Times New Roman';\"><span lang=\"ar-SA\"><span style=\"font-family: 'Noto Sans';\"><span lang=\"hi-IN\"><strong>\u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u0930\u093e\u091c\u094d\u092f \u0938\u0939\u0915\u093e\u0930\u0940 \u0935\u093f\u092a\u0923\u0928 \u0938\u0902\u0918 </strong></span></span></span></span><span style=\"font-family: 'Noto Sans',serif;\"><strong>(</strong></span><span style=\"fo