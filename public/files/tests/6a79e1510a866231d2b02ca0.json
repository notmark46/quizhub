u092e\u0927\u094d\u092f\u092e\u0915\u093e\u0932\u0940\u0928\n \u0935 \u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932\u0940\u0928\n \u090b\u0923 \u092a\u094d\u0930\u0926\u093e\u0928&nbsp;\u0915\u0930\u0928\u093e&nbsp;</span></span></span></span></p>\n ", "nameText": "\n \u092d\u0942\u092e\u093f\n \u0915\u0947 \u092c\u0926\u0932\u0947 \u0915\u093f\u0938\u093e\u0928\u094b\u0902\n \u0915\u094b \u0905\u0932\u094d\u092a\u0915\u093e\u0932\u0940\u0928,\n \u092e\u0927\u094d\u092f\u092e\u0915\u093e\u0932\u0940\u0928\n \u0935 \u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932\u0940\u0928\n \u090b\u0923 \u092a\u094d\u0930\u0926\u093e\u0928&nbsp;\u0915\u0930\u0928\u093e&nbsp;\n ", "isCorrect": false, "_id": "66b0a1da2c1fbc68131cac72", "isMarked": false}, {"name": "<p style=\"text-decoration: none\">\n <span style=\"color: #000000\"><span style=\"font-family: Calibri\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans'\">\u0915\u093f\u0938\u093e\u0928\u094b\u0902\n \u0915\u094b \u0905\u0928\u0941\u0926\u093e\u0928 \u0914\u0930\n \u092c\u094d\u092f\u093e\u091c \u092e\u0941\u0915\u094d\u0924\n \u090b\u0923 \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0930\u0935\u093e\u0928\u093e&nbsp;</span></span></span></span></p>\n ", "nameText": "\n \u0915\u093f\u0938\u093e\u0928\u094b\u0902\n \u0915\u094b \u0905\u0928\u0941\u0926\u093e\u0928 \u0914\u0930\n \u092c\u094d\u092f\u093e\u091c \u092e\u0941\u0915\u094d\u0924\n \u090b\u0923 \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0930\u0935\u093e\u0928\u093e&nbsp;\n ", "isCorrect": false, "_id": "66b0a1da2c1fbc48471cac73", "isMarked": false}], "solution": "<ul>\n<li style=\"text-decoration: none;\">\u0930\u093e\u091c\u092b\u0948\u0921 (RAJFED) \u0915\u093e \u092a\u0942\u0930\u093e \u0928\u093e\u092e '\u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u0938\u094d\u091f\u0947\u091f \u0915\u094b-\u0911\u092a\u0930\u0947\u091f\u093f\u0935 \u092e\u093e\u0930\u094d\u0915\u0947\u091f\u093f\u0902\u0917 \u092b\u0947\u0921\u0930\u0947\u0936\u0928 \u0932\u093f\u092e\u093f\u091f\u0947\u0921' \u0939\u0948\u0964</li>\n<li style=\"text-decoration: none;\">\u0907\u0938\u0915\u0940 \u0938\u094d\u0925\u093e\u092a\u0928\u093e 1957 \u092e\u0947\u0902 \u0939\u0941\u0908 \u0925\u0940\u0964 \u092f\u0939 \u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u0915\u0947 \u0915\u093f\u0938\u093e\u0928\u094b\u0902 \u0915\u094b \u0938\u092e\u0930\u094d\u0925\u0928 \u092e\u0942\u0932\u094d\u092f (MSP) \u092a\u0930 \u092b\u0938\u0932 \u092c\u0947\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0911\u0928\u0932\u093e\u0907\u0928 \u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u0915\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u0914\u0930 \u0909\u091a\u093f\u0924 \u0926\u093e\u092e \u092a\u0930 \u092c\u0940\u091c, \u0909\u0930\u094d\u0935\u0930\u0915 \u0935 \u0915\u0940\u091f\u0928\u093e\u0936\u0915 \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0930\u093e\u0924\u093e \u0939\u0948</li>\n<li style=\"text-decoration: none;\">\u0930\u093e\u091c\u092b\u0948\u0921 (RAJFED) \u0938\u0947 \u091c\u0941\u0921\u093c\u0940 \u092e\u0941\u0916\u094d\u092f \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0939\u0948: \u092e\u0941\u0916\u094d\u092f \u0915\u093e\u0930\u094d\u092f \u0914\u0930 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u092b\u0938\u0932\u094b\u0902 \u0915\u0940 \u0916\u0930\u0940\u0926: \u0915\u093f\u0938\u093e\u0928\u094b\u0902 \u0915\u094b \u092c\u093f\u091a\u094c\u0932\u093f\u092f\u094b\u0902 \u0938\u0947 \u092c\u091a\u093e\u0928\u0947 \u0914\u0930 \u0909\u0928\u0915\u0940 \u092b\u0938\u0932\u094b\u0902 (\u091c\u0948\u0938\u0947- \u0917\u0947\u0939\u0942\u0902, \u0938\u0930\u0938\u094b\u0902, \u091a\u0928\u093e, \u092e\u0942\u0902\u0917) \u0915\u093e \u0938\u0939\u0940 \u0926\u093e\u092e \u0926\u093f\u0932\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0938\u092e\u0930\u094d\u0925\u0928 \u092e\u0942\u0932\u094d\u092f (MSP) \u092a\u0930 \u0916\u0930\u0940\u0926 \u0915\u093e \u0938\u0902\u091a\u093e\u0932\u0928 \u0915\u0930\u0928\u093e</li>\n<li style=\"text-decoration: none;\">\u0915\u0943\u0937\u093f \u0906\u0926\u093e\u0928 (Agricultural Inputs): \u0915\u093f\u0938\u093e\u0928\u094b\u0902 \u0915\u094b \u0909\u091a\u093f\u0924 \u092e\u0942\u0932\u094d\u092f \u092a\u0930 \u0909\u091a\u094d\u091a \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0935\u093e\u0932\u0947 \u092c\u0940\u091c, \u0909\u0930\u094d\u0935\u0930\u0915 \u0914\u0930 \u0915\u0940\u091f\u0928\u093e\u0936\u0915 \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0930\u093e\u0928\u093e</li>\n<li style=\"text-decoration: none;\">\u092c\u092b\u0930 \u0938\u094d\u091f\u0949\u0915\u093f\u0902\u0917: \u0930\u093e\u091c\u094d\u092f \u0915\u0947 \u0915\u093f\u0938\u093e\u0928\u094b\u0902 \u0915\u094b \u0906\u0935\u0936\u094d\u092f\u0915 \u0909\u0930\u094d\u0935\u0930\u0915\u094b\u0902 \u0915\u0940 \u0928\u093f\u0930\u0902\u0924\u0930 \u0906\u092a\u0942\u0930\u094d\u0924\u093f \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u093e</li>\n</ul>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": false, "isPartiallyCorrect": false, "isCorrect": false, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6aca4f12333022647e214c81", "marks": {"positive": 0, "negative": 0}, "timeTaken": 0, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null, "year": "2013"}, {"_id": "66b0a7ffdcc06ca8207612d5", "name": "<p style=\"text-decoration: none;\"><span style=\"color: #000000;\"><span style=\"font-family: Calibri;\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans';\"><strong>\u0938\u0939\u0915\u093e\u0930\u0940 \u0938\u093e\u0916 \u0922\u093e\u0901\u091a\u0947 \u0915\u0947 \u0905\u0928\u094d\u0924\u0930\u094d\u0917\u0924 \u0928\u093f\u092e\u094d\u0928 \u092e\u0947\u0902 \u0938\u0947 \u0915\u094c\u0928</strong></span></span></span><span style=\"font-fa