094d\u0925\u093e\u0928 \u0915\u093e \u0924\u0948\u0902\u0924\u0940\u0938\u0935\u093e\u0902 \u091c\u093f\u0932\u093e (\u091c\u094b 2007 \u092e\u0947\u0902 \u092c\u0928\u093e) \u0915\u093f\u0938 \u0938\u0902\u092d\u093e\u0917\u00a0\u092e\u0947\u0902 \u0939\u0948?\u00a0\u00a0\n\u0935\u0930\u093f\u0937\u094d\u0920 \u0905\u0927\u094d\u092f\u093e\u092a\u0915\u00a02010\u00a0\u092a\u0947\u092a\u0930\u00a0-I GK\u00a0(SST)", "sectionId": "6a79e12516d2ecd9f3664462", "order": 3, "questionSubmitOrder": 3, "options": [{"name": "<p style=\"text-decoration: none\">\n <span style=\"color: #000000\"><span style=\"font-family: Calibri\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans'\">\u092d\u0930\u0924\u092a\u0941\u0930&nbsp;</span></span></span></span></p>\n ", "nameText": "\n \u092d\u0930\u0924\u092a\u0941\u0930&nbsp;\n ", "isCorrect": false, "_id": "673b3515f4015b2b72468147", "isMarked": false}, {"name": "<p style=\"text-decoration: none\">\n <span style=\"color: #000000\"><span style=\"font-family: Calibri\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans'\">\u0915\u094b\u091f\u093e</span></span></span></span></p>\n ", "nameText": "\n \u0915\u094b\u091f\u093e\n ", "isCorrect": false, "_id": "673b3515f4015bdb76468148", "isMarked": false}, {"name": "<p style=\"text-decoration: none\">\n <span style=\"color: #000000\"><span style=\"font-family: Calibri\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans'\">\u0905\u091c\u092e\u0947\u0930&nbsp;</span></span></span></span></p>\n ", "nameText": "\n \u0905\u091c\u092e\u0947\u0930&nbsp;\n ", "isCorrect": false, "_id": "673b3515f4015b0acb468149", "isMarked": false}, {"name": "<p style=\"text-decoration: none;\"><span style=\"color: #000000;\"><span style=\"font-family: Calibri;\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans';\">\u0909\u0926\u092f\u092a\u0941\u0930&nbsp;</span></span></span></span></p>", "nameText": "\u0909\u0926\u092f\u092a\u0941\u0930\u00a0", "isCorrect": true, "_id": "673b3515f4015bd3dc46814a", "isMarked": false}], "solution": "<h3><strong>\ud83d\udd39 \u0935\u094d\u092f\u093e\u0916\u094d\u092f\u093e:</strong></h3>\n<p>\ud83d\udc49 <strong>\u092a\u094d\u0930\u0924\u093e\u092a\u0917\u0922\u093c</strong> \u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u0915\u093e <strong>33\u0935\u093e\u0901 \u091c\u093f\u0932\u093e</strong> \u0939\u0948, \u091c\u094b <strong>26 \u091c\u0928\u0935\u0930\u0940 2008</strong> \u0915\u094b \u0905\u0938\u094d\u0924\u093f\u0924\u094d\u0935 \u092e\u0947\u0902 \u0906\u092f\u093e\u0964<br />\ud83d\udc49 \u092f\u0939 \u091c\u093f\u0932\u093e <strong>\u0909\u0926\u092f\u092a\u0941\u0930 \u0938\u0902\u092d\u093e\u0917</strong> \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0915\u0941\u0932 <strong>7 \u091c\u093f\u0932\u0947</strong> \u0939\u0948\u0902\u0964<br />\ud83d\udc49 \u0930\u093e\u091c\u094d\u092f \u092e\u0947\u0902 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 <strong>7 \u0938\u0902\u092d\u093e\u0917</strong> \u0914\u0930 <strong>41 \u091c\u093f\u0932\u0947</strong> \u0939\u0948\u0902, \u091c\u093f\u0928\u092e\u0947\u0902 \u0915\u0941\u091b \u091c\u093f\u0932\u094b\u0902 \u0915\u093e \u092a\u0941\u0928\u0930\u094d\u0917\u0920\u0928 2024 \u092e\u0947\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964<br />\ud83d\udc49 \u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u092e\u0947\u0902 <strong>\u0938\u0902\u092d\u093e\u0917 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e</strong> \u0915\u094b 1987 \u092e\u0947\u0902 \u092a\u0941\u0928\u0903 \u0932\u093e\u0917\u0942 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964</p>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": false, "isPartiallyCorrect": false, "isCorrect": false, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6aca4ebcb426bb1429ee3900", "marks": {"positive": 0, "negative": 0}, "timeTaken": 0, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null, "year": "2010"}]}