ame": "<p><span style=\"color: #0d0d0d; font-family: 'Noto Sans', sans-serif; text-align: justify;\">\u091c\u094d\u0935\u093e\u0932\u093e \u092e\u093e\u0924\u093e</span></p>", "nameText": "\u091c\u094d\u0935\u093e\u0932\u093e \u092e\u093e\u0924\u093e", "isCorrect": false, "_id": "670a5480a4dd8a8dd31d2a8b", "isMarked": false}, {"name": "<p><span style=\"color: #0d0d0d; font-family: 'Noto Sans', sans-serif; text-align: justify;\">\u0924\u0928\u094b\u091f \u092e\u093e\u0924\u093e</span></p>", "nameText": "\u0924\u0928\u094b\u091f \u092e\u093e\u0924\u093e", "isCorrect": true, "_id": "670a5480a4dd8a458a1d2a8c", "isMarked": false}], "solution": "<h3>\ud83d\udd39 \u0935\u094d\u092f\u093e\u0916\u094d\u092f\u093e</h3>\n<p>\ud83d\udc49 \u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u0915\u0940 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0932\u094b\u0915\u0926\u0947\u0935\u0940 <strong>\u0924\u0928\u094b\u091f \u092e\u093e\u0924\u093e</strong> \u0915\u093e \u0938\u0902\u092c\u0902\u0927 <strong>\u091c\u0948\u0938\u0932\u092e\u0947\u0930</strong> \u0938\u0947 \u0939\u0948\u0964<br />\ud83d\udc49 \u0907\u0928\u094d\u0939\u0947\u0902 \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0947 <strong>&ldquo;\u0925\u093e\u0930 \u0915\u0940 \u0935\u0948\u0937\u094d\u0923\u094b \u0926\u0947\u0935\u0940&rdquo;</strong> \u0915\u0939\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964<br />\ud83d\udc49 \u0907\u0928\u0915\u093e \u092e\u0902\u0926\u093f\u0930 <strong>\u0924\u0928\u094b\u091f</strong> \u092e\u0947\u0902 \u0938\u094d\u0925\u093f\u0924 \u0939\u0948, \u091c\u093f\u0938\u0947 <em>\u0930\u0942\u092e\u093e\u0932 \u0935\u093e\u0932\u093e \u092e\u0902\u0926\u093f\u0930</em> \u092d\u0940 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902\u0964<br />\ud83d\udc49 \u092f\u0939\u093e\u0901 <strong>BSF \u0915\u0947 \u091c\u0935\u093e\u0928</strong> \u092a\u0942\u091c\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0928\u0935\u0930\u093e\u0924\u094d\u0930\u094b\u090