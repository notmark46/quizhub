: false, "_id": "67ab4c8edd6275c0e14bab31", "isMarked": false}, {"name": "<p lang=\"en-US\" style=\"text-decoration: none;\"><span style=\"color: #000000;\"><span style=\"font-family: Calibri;\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans';\">\u091c\u093f\u0932\u093e \u092a\u094d\u0930\u092e\u0941\u0916&nbsp;</span></span></span></span></p>", "nameText": "\u091c\u093f\u0932\u093e \u092a\u094d\u0930\u092e\u0941\u0916\u00a0", "isCorrect": true, "_id": "67ab4c8edd6275fff84bab32", "isMarked": false}], "solution": "<h3>\ud83d\udd39 <strong>\u0935\u094d\u092f\u093e\u0916\u094d\u092f\u093e</strong></h3>\n<p>\ud83d\udc49 <strong>\u091c\u093f\u0932\u093e \u092f\u094b\u091c\u0928\u093e \u0938\u092e\u093f\u0924\u093f (District Planning Committee)</strong> \u0915\u093e \u0917\u0920\u0928 \u091c\u093f\u0932\u0947 \u0915\u0947 <strong>\u0938\u092e\u0917\u094d\u0930 \u0935\u093f\u0915\u093e\u0938 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0947 \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0914\u0930 \u0938\u092e\u0928\u094d\u0935\u092f</strong> \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964<br />\ud83d\udc49 \u092f\u0939 \u0938\u092e\u093f\u0924\u093f <strong>\u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0928\u093f\u0915\u093e\u092f\u094b\u0902 \u0915\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u093e \u090f\u0915\u0940\u0915\u0930\u0923</strong> \u0915\u0930 \u091c\u093f\u0932\u0947 \u0915\u0947 <strong>\u0938\u0902\u0924\u0941\u0932\u093f\u0924 \u0935\u093f\u0915\u093e\u0938</strong> \u0915\u0940 \u0926\u093f\u0936\u093e \u092e\u0947\u0902 \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0924\u0940 \u0939\u0948\u0964<br />\ud83d\udc49 \u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u092e\u0947\u0902 \u091c\u093f\u0932\u093e \u092f\u094b\u091c\u0928\u093e \u0938\u092e\u093f\u0924\u093f \u092e\u0947\u0902 25 \u0938\u0926\u0938\u094d\u092f \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u091c\u093f\u0928\u092e\u0947\u0902 \u092a\u0902\u091a\u093e\u092f\u0924 \u0930\u093e\u091c \u0938\u0902\u0938\u094d\u0925\u093e\u0913\u0902 \u090f\u0935\u0902 \u0928\u0917\u0930 \u092a\u093e\u0932\u093f\u0915\u093e\u0913\u0902 \u0915\u0947 \u0928\u093f\u0930\u094d\u0935\u093e\u091a\u093f\u0924 \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f\u092f\u094b\u0902 \u0938\u0947 \u091a\u0941\u0928\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902, \u0936\u0947\u0937 \u092a\u093e\u0902\u091a \u092e\u0947\u0902 \u0938\u0947 \u0924\u0940\u0928 \u092a\u0926\u0947\u0928 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0926\u094b \u0938\u0930\u0915\u093e\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0928\u093e\u092e\u093f\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902</p>\n<p></p>\n<p>\u270d\ufe0f \u0938\u0939\u0940 \u0909\u0924\u094d\u0924\u0930 \u0939\u0948 &ndash; <strong>\u091c\u093f\u0932\u093e \u092a\u094d\u0930\u092e\u0941\u0916&nbsp;</strong></p>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": false, "isPartiallyCorrect": false, "isCorrect": false, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6aca5536eefa621e39ee0bf7", "marks": {"positive": 0, "negative": 0}, "timeTaken": 0, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null, "year": "2025"}]}