\u0928 \u0938\u0947 \u091c\u0941\u0921\u093c\u0947 \u0938\u092d\u0940 \u092e\u093e\u092e\u0932\u094b\u0902 \u092e\u0947\u0902 <strong>\u092e\u0941\u0916\u094d\u092f\u092e\u0902\u0924\u094d\u0930\u0940 \u0915\u0947 \u092e\u0941\u0916\u094d\u092f \u0938\u0932\u093e\u0939\u0915\u093e\u0930</strong> \u0930\u093e\u091c\u094d\u092f \u0915\u0947 <strong>\u092e\u0941\u0916\u094d\u092f \u0938\u091a\u093f\u0935</strong> \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964<br />\ud83d\udc49 \u092e\u0941\u0916\u094d\u092f \u0938\u091a\u093f\u0935 \u0930\u093e\u091c\u094d\u092f \u0938\u0930\u0915\u093e\u0930 \u0915\u093e <strong>\u0935\u0930\u093f\u0937\u094d\u0920\u0924\u092e \u092a\u094d\u0930\u0936\u093e\u0938\u0928\u093f\u0915 \u0905\u0927\u093f\u0915\u093e\u0930\u0940</strong> \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964<br />\ud83d\udc49 \u0935\u0947 \u092e\u0941\u0916\u094d\u092f\u092e\u0902\u0924\u094d\u0930\u0940 \u0915\u094b <strong>\u0936\u093e\u0938\u0928, \u0928\u0940\u0924\u093f\u092f\u094b\u0902 \u0914\u0930 \u092a\u094d\u0930\u0936\u093e\u0938\u0928\u093f\u0915 \u0928\u093f\u0930\u094d\u0923\u092f\u094b\u0902</strong> \u092a\u0930 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964<br />\ud83d\udc49 \u092e\u0941\u0916\u094d\u092f \u0938\u091a\u093f\u0935 \u0938\u092d\u0940 \u0935\u093f\u092d\u093e\u0917\u094b\u0902 \u0915\u0947 <strong>\u0938\u092e\u0928\u094d\u0935\u092f \u0914\u0930 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923</strong> \u0915\u0940 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940 \u0928\u093f\u092d\u093e\u0924\u0947 \u0939\u0948\u0902\u0964<br />\ud83d\udc49 \u0930\u093e\u091c\u094d\u092f \u092a\u094d\u0930\u0936\u093e\u0938\u0928 \u0915\u093e \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u0938\u0902\u091a\u093e\u0932\u0928 \u0909\u0928\u0915\u0947 <strong>\u092a\u094d\u0930\u0936\u093e\u0938\u0928\u093f\u0915 \u0928\u0947\u0924\u0943\u0924\u094d\u0935