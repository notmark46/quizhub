u092e</strong> \u0915\u0940 \u092a\u0930\u093f\u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0938\u0902\u092f\u0902\u0924\u094d\u0930 \u0914\u0930 \u092e\u0936\u0940\u0928\u0930\u0940 \u092e\u0947\u0902 \u0928\u093f\u0935\u0947\u0936 \u0915\u0940 \u0938\u0940\u092e\u093e \u0924\u092f \u0915\u0940 \u0917\u0908 \u0939\u0948\u0964<br />\ud83d\udc49 \u0907\u0938 \u0938\u0940\u092e\u093e \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0928\u093f\u0935\u0947\u0936 <strong>25 \u0932\u093e\u0916 \u0930\u0941\u092a\u092f\u0947 \u0938\u0947 5 \u0915\u0930\u094b\u0921\u093c \u0930\u0941\u092a\u092f\u0947</strong> \u0915\u0947 \u092c\u0940\u091a \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964<br />\ud83d\udc49 \u092f\u0939 \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u0938\u0942\u0915\u094d\u0937\u094d\u092e, \u0932\u0918\u0941 \u0914\u0930 \u092e\u0927\u094d\u092f\u092e \u0909\u0926\u094d\u092f\u092e\u094b\u0902 (MSME) \u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964</p>\n<p>\u270d\ufe0f \u0938\u0939\u0940 \u0909\u0924\u094d\u0924\u0930 \u0939\u0948 &ndash; <strong>25 \u0932\u093e\u0916 \u0930\u0941\u092a\u092f\u0947 \u0938\u0947 5 \u0915\u0930\u094b\u0921\u093c \u0930\u0941\u092a\u092f\u0947</strong></p>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": false, "isPartiallyCorrect": false, "isCorrect": false, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6aca51e252d04218c1cf23a5", "marks": {"positive": 0, "negative": 0}, "timeTaken": 0, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null, "year": "2018"}]}