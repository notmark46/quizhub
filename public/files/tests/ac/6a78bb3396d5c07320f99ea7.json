05\u0915\u093e\u0926\u092e\u0940 <strong>\u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u0915\u0940 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u0927\u0930\u094b\u0939\u0930</strong> \u0915\u094b \u0938\u0939\u0947\u091c\u0928\u0947 \u0915\u093e \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0924\u0940 \u0939\u0948\u0964</p>\n<p></p>\n<p>\u270d\ufe0f \u0938\u0939\u0940 \u0909\u0924\u094d\u0924\u0930 \u0939\u0948 &ndash; <strong>\u092c\u0940\u0915\u093e\u0928\u0947\u0930&nbsp;</strong></p>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": false, "isPartiallyCorrect": false, "isCorrect": false, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6ac94bab8c3d67362b99130c", "marks": {"positive": 0, "negative": 0}, "timeTaken": 0, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null}]}