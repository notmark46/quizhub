ont-family: 'Noto Sans'\">\u0921\u0942\u0902\u0917\u091c\u0940&nbsp;</span></span></span></span></p>\n ", "nameText": "\n \u0921\u0942\u0902\u0917\u091c\u0940&nbsp;\n ", "isCorrect": false, "_id": "689332181ae67b75d1374ef3", "isMarked": false}], "solution": "<h3>\ud83d\udd39 \u0935\u094d\u092f\u093e\u0916\u094d\u092f\u093e</h3>\n<p>\ud83d\udc49 <strong>\u0935\u093e\u0917\u0921\u093c \u092a\u094d\u0930\u0926\u0947\u0936</strong> \u092e\u0947\u0902 \u0905\u0928\u0947\u0915 \u0932\u094b\u0915\u0915\u0925\u093e\u090f\u0901 \u092a\u094d\u0930\u091a\u0932\u093f\u0924 \u0930\u0939\u0940 \u0939\u0948\u0902\u0964 \u0922\u094b\u0932\u093e \u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u0915\u093e \u0938\u092c\u0938\u0947 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0932\u094b\u0915 \u0917\u093e\u0925\u093e \u0939\u0948 \u091c\u094b \u0922\u094b\u0932\u093e \u092e\u093e\u0930\u0942 \u0915\u0947 \u092e\u0939\u093e\u0928\u093e\u092f\u0915 \u0925\u0947 \u0922\u094b\u0932\u093e \u0928\u0930\u0935\u0930 ( \u092e\u0927\u094d\u092f \u092a\u094d\u0930\u0926\u0947\u0936) \u0915\u0947 \u0930\u093e\u091c\u0915\u0941\u092e\u093e\u0930 \u0925\u0947 \u091c\u093f\u0928\u0915\u093e \u0935\u093f\u0935\u093e\u0939 \u092c\u0940\u0915\u093e\u0928\u0947\u0930 \u0915\u0940 \u0930\u093e\u091c\u0915\u0941\u092e\u093e\u0930\u0940 \u092e\u093e\u0930\u0942 \u0938\u0947 \u0939\u094b \u0917\u092f\u093e \u0925\u093e \u090f\u0915 \u0905\u0928\u0942\u0920\u0940 \u092a\u094d\u0930\u0947\u092e \u0915\u0925\u093e \u0915\u093e \u092a\u094d\u0930\u0924\u0940\u0915 \u0939\u0948\u0964 \u0921\u0942\u0902\u0917\u091c\u0940 \u092f\u0939 \u0936\u0947\u0916\u093e\u0935\u093e\u091f\u0940 \u0915\u0947 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0932\u094b\u0915 \u0926\u0947\u0935\u0924\u093e \u0914\u0930 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930\u0924\u093e \u0938\u0947\u0928\u093e\u0928\u0940 \u0921\u0942\u0902\u0917\u091c\u093f\u0917 \u091c\u0935\u093e\u0939\u0930 \u091c\u0940 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 ,\u0907\u0928\u094d\u0939\u0947\u0902 \u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u0915\u093e \u0930\u0949\u092c\u093f\u0928 \u0939\u0941\u0921 \u0915\u0939\u093e \u091c\u093e\u0924\u093e \u0939\u0948<br />\ud83d\udc49 \u0907\u0928\u094d\u0939\u0940\u0902 \u092e\u0947\u0902 \u090f\u0915 \u092a\u094d\u0930\u092e\u0941\u0916 \u0932\u094b\u0915\u0915\u0925\u093e <strong>'\u0917\u0932\u093e\u0932\u0947\u0902\u0917'</strong> \u0939\u0948\u0964<br />\ud83d\udc49 \u0907\u0938 \u0915\u0925\u093e \u0915\u0947 <strong>\u0928\u093e\u092f\u0915 \u0917\u0941\u0932\u093e\u0932 \u0938\u093f\u0902\u0939</strong> \u092e\u093e\u0928\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964<br />\ud83d\udc49 \u0932\u094b\u0915\u092e\u093e\u0928\u0938 \u092e\u0947\u0902 \u092f\u0939 \u0915\u0925\u093e <strong>\u0935\u0940\u0930\u0924\u093e \u0914\u0930 \u0932\u094b\u0915\u0935\u093f\u0936\u094d\u0935\u093e\u0938</strong> \u0915\u093e \u092a\u094d\u0930\u0924\u0940\u0915 \u0939\u0948\u0964</p>\n<p></p>\n<p>\u270d\ufe0f \u0938\u0939\u0940 \u0909\u0924\u094d\u0924\u0930 \u0939\u0948 &ndash; <strong>\u0917\u0941\u0932\u093e\u0932 \u0938\u093f\u0902\u0939&nbsp;</strong></p>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": false, "isPartiallyCorrect": false, "isCorrect": false, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6ac94bd59ca2233d96895b8e", "marks": {"positive": 0, "negative": 0}, "timeTaken": 0, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null}]}