mily: 'Noto Sans';\">\u0938\u0935\u093e\u0908 \u092a\u094d\u0930\u0924\u093e\u092a\u0938\u093f\u0902\u0939</span><span style=\"font-family: 'Noto Sans';\"><span lang=\"ar-SA\">&nbsp;</span></span></span></span></span></p>", "nameText": "\u0938\u0935\u093e\u0908 \u092a\u094d\u0930\u0924\u093e\u092a\u0938\u093f\u0902\u0939\u00a0", "isCorrect": true, "_id": "64af647a34f9098cf06abff4", "isMarked": false}], "solution": "<h3>\ud83d\udd39 \u0935\u094d\u092f\u093e\u0916\u094d\u092f\u093e</h3>\n<p>\ud83d\udc49 <strong>\u0939\u0935\u093e \u092e\u0939\u0932</strong> \u0915\u093e \u0928\u093f\u0930\u094d\u092e\u093e\u0923 <strong>\u091c\u092f\u092a\u0941\u0930</strong> \u092e\u0947\u0902 \u0939\u0941\u0906\u0964 \u092f\u0939 \u092a\u093e\u0902\u091a \u092e\u0902\u091c\u093f\u0932\u093e \u0907\u092e\u093e\u0930\u0924 \u0939\u0948 \u091c\u094b \u0907\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u0939\u0948 1 \u0936\u0930\u0926 \u092e\u0902\u0926\u093f\u0930, 2. \u0930\u0924\u0928 \u092e\u0902\u0926\u093f\u0930, 3. \u0935\u093f\u091a\u093f\u0924\u094d\u0930 \u092e\u0902\u0926\u093f\u0930 , 4. \u092a\u094d\u0930\u0915\u093e\u0936 \u092e\u0902\u0926\u093f\u0930 \u0914\u0930 5. \u0939\u0935\u093e \u092e\u0902\u0926\u093f\u0930\u0964 \u0939\u0935\u093e \u092e\u0939\u0932 \u0915\u0940 \u0906\u0915\u0943\u0924\u093f \u0936\u094d\u0930\u0940 \u092d\u0917\u0935\u093e\u0928 \u0915\u0943\u0937\u094d\u0923 \u0915\u0947 \u092e\u0941\u0915\u0941\u091f \u091c\u0948\u0938\u0940 \u0939\u0948 \u0907\u0938\u092e\u0947\u0902 \u0939\u0935\u093e \u0906\u0928\u0947-\u091c\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f 953 \u092c\u0947\u0939\u0926 \u0916\u0942\u092c\u0938\u0942\u0930\u0924 \u091b\u094b\u091f\u0947 \u091d\u0930\u094b\u0916\u0947 \u092c\u0928\u0947 \u0939\u0941\u090f \u0939\u0948\u0902\u0964<br />\ud83d\udc49 \u0907\u0938\u0947 <strong>\u092e\u0939\u093e\u0930\u093e\u091c\u093e \u0938\u0935\u093e\u0908 \u092a\u094d\u0930\u0924\u093e\u092a \u0938\u093f\u0902\u0939</strong> \u0928\u0947 \