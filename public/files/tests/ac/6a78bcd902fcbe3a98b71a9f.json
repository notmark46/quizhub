"options": [{"name": "<p style=\"text-decoration: none\">\n <span style=\"color: #000000\"><span style=\"font-family: Calibri\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans'\">\u0935\u093e\u0917\u0921\u093c&nbsp;</span></span></span></span></p>\n ", "nameText": "\n \u0935\u093e\u0917\u0921\u093c&nbsp;\n ", "isCorrect": false, "_id": "67ee4ddd5af21eb96e00de7b", "isMarked": true}, {"name": "<p style=\"text-decoration: none;\"><span style=\"color: #000000;\"><span style=\"font-family: Calibri;\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans';\">\u0922\u0942\u0901\u0922\u093e\u0921\u093c</span></span></span></span></p>", "nameText": "\u0922\u0942\u0901\u0922\u093e\u0921\u093c", "isCorrect": true, "_id": "67ee4ddd5af21ece9100de7c", "isMarked": false}, {"name": "<p style=\"text-decoration: none\">\n <span style=\"color: #000000\"><span style=\"font-family: Calibri\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans'\">\u0917\u094b\u0921\u0935\u093e\u0930&nbsp;</span></span></span></span></p>\n ", "nameText": "\n \u0917\u094b\u0921\u0935\u093e\u0930&nbsp;\n ", "isCorrect": false, "_id": "67ee4ddd5af21e49a200de7d", "isMarked": false}, {"name": "<p style=\"text-decoration: none\">\n <span style=\"color: #000000\"><span style=\"font-family: Calibri\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans'\">\u092e\u0947\u0930\u0935\u093e\u0921\u093c\u093e&nbsp;</span></span></span></span></p>\n ", "nameText": "\n \u092e\u0947\u0930\u0935\u093e\u0921\u093c\u093e&nbsp;\n ", "isCorrect": false, "_id": "67ee4ddd5af21eda0700de7e", "isMarked": false}], "solution": "<h3>\ud83d\udd39 \u0935\u094d\u092f\u093e\u0916\u094d\u092f\u093e</h3>\n<p>\ud83d\udc49 <strong>\u0922\u0942\u0902\u0922\u093e\u0921\u093c \u0938\u0930\u094d\u0915\u093f\u091f</strong> \u092e\u0947\u0902 <strong>\u091c\u092f\u092a\u0941\u0930, \u0926\u094c\u0938\u093e \u0914\u0930 \u091f\u094b\u0902\u0915</strong> \u091c\u093f\u0932\u0947 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902\u0964<br />\ud83d\udc49 \u092f\u0939 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 <strong>\u0907\u0924\u093f\u0939\u093e\u0938, \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f, \u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e \u0914\u0930 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0938\u094d\u0925\u0932\u094b\u0902</strong> \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948\u0964<br />\ud83d\udc49 \u0907\u0938 \u0938\u0930\u094d\u0915\u093f\u091f \u092e\u0947\u0902 <strong>\u0938\u093e\u092e\u094b\u0926, \u0906\u092d\u093e\u0928\u0947\u0930\u0940 \u0914\u0930 \u0930\u093e\u092e\u0917\u0922\u093c</strong> \u091c\u0948\u0938\u0947 \u0938\u094d\u0925\u0932 \u092d\u0940 \u0906\u0924\u0947 \u0939\u0948\u0902\u0964<br />\ud83d\udc49 \u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u092e\u0947\u0902 \u0905\u0928\u094d\u092f \u0938\u0930\u094d\u0915\u093f\u091f \u091c\u0948\u0938\u0947 <strong>\u092d\u0930\u0924\u092a\u0941\u0930-\u0921\u0940\u0902\u0917-\u0927\u094c\u0932\u092a\u0941\u0930</strong> \u0914\u0930 <strong>\u091c\u0948\u0938\u0932\u092e\u0947\u0930-\u091c\u094b\u0927\u092a\u0941\u0930-\u092c\u0940\u0915\u093e\u0928\u0947\u0930-\u092c\u093e\u0921\u093c\u092e\u0947\u0930-\u0928\u093e\u0917\u094c\u0930</strong> \u092d\u0940 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948\u0902\u0964</p>\n<p></p>\n<p>\u270d\ufe0f \u0938\u0939\u0940 \u0909\u0924\u094d\u0924\u0930 \u0939\u0948 &ndash;&nbsp;<span style=\"color: #000000;\"><strong>\u0922\u0942\u0901\u0922\u093e\u0921\u093c</strong>&nbsp;</span></p>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": true, "isPartiallyCorrect": false, "isCorrect": false, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6ac94c7a5fc0517c59205ef4", "marks": {"positive": 0, "negative": 0.66}, "timeTaken": 9000, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null}]}