37\u093f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 <strong>4% \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u0935\u0943\u0926\u094d\u0927\u093f \u0926\u0930</strong> \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u093e \u0925\u093e\u0964<br />\ud83d\udc49 \u092f\u0939 \u0930\u093e\u091c\u094d\u092f\u094b\u0902 \u0915\u094b \u0915\u0943\u0937\u093f \u0935\u093f\u0915\u093e\u0938 \u092e\u0947\u0902 <strong>\u0938\u0939\u093e\u092f\u0924\u093e \u092a\u094d\u0930\u0926\u093e\u0928</strong> \u0915\u0930\u0928\u0947 \u0939\u0947\u0924\u0941 \u0932\u093e\u0917\u0942 \u0915\u0940 \u0917\u0908\u0964</p>\n<p></p>\n<p>\u270d\ufe0f \u0938\u0939\u0940 \u0909\u0924\u094d\u0924\u0930 \u0939\u0948 &ndash; <strong>2007&nbsp;</strong></p>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": false, "isPartiallyCorrect": false, "isCorrect": false, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6ac94b701a03ec6adc56e052", "marks": {"positive": 0, "negative": 0}, "timeTaken": 0, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null}]}