927 \u0939\u0948\u0964<br />\ud83d\udc49 \u0907\u0938\u0947 \u0909\u0938 \u0938\u092e\u092f <strong>\u0936\u0939\u0930 \u0915\u0940 \u091c\u0932-\u0938\u0902\u091a\u092f\u0928 \u092a\u094d\u0930\u0923\u093e\u0932\u0940</strong> \u0915\u093e \u090f\u0915 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u092d\u093e\u0917 \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0925\u093e\u0964<br />\ud83d\udc49 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u092f\u0939 \u0938\u094d\u0925\u0932 <strong>\u091c\u094b\u0927\u092a\u0941\u0930 \u0915\u0947 \u092a\u0941\u0930\u093e\u0928\u0947 \u0936\u0939\u0930 \u0915\u093e \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u092a\u0930\u094d\u092f\u091f\u0928 \u0906\u0915\u0930\u094d\u0937\u0923</strong> \u092c\u0928 \u091a\u0941\u0915\u093e \u0939\u0948\u0964</p>\n<p></p>\n<p>\u270d\ufe0f \u0938\u0939\u0940 \u0909\u0924\u094d\u0924\u0930 \u0939\u0948 &ndash;<strong> \u091c\u094b\u0927\u092a\u0941\u0930&nbsp;</strong></p>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": false, "isPartiallyCorrect": false, "isCorrect": false, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6ac94e7cd063c183e205ba2f", "marks": {"positive": 0, "negative": 0}, "timeTaken": 0, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null}, {"_id": "68db7be7a76d6e097321fec0", "name": "<p class=\"western\" style=\"margin-bottom: 0px;\"><span style=\"font-family: 'Times New Roman';\"><span lang=\"ar-SA\"><span style=\"font-family: 'Noto Sans';\"><span lang=\"hi-IN\"><strong>\u0928\u093f\u092e\u094d\u0928 \u092e\u0947\u0902 \u0938\u0947 \u0915\u094c\u0928 \u0938\u093e \u0936\u092c\u094d\u0926 \u0909\u0928 \u0938\u094d\u092e\u093e\u0930\u0915\u094b\u0902 \u0915\u0940 \u0938\u0926\u093f\u092f\u094b\u0902 \u092a\u0941\u0930\u093e\u0928\u0940 \u092a\u0930\u0902\u092a\u0930\u093e \u0915\u094b \u092a\u0930\u093f\u092d\u093e\u0937\u093f\u