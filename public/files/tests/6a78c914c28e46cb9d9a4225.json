e \u0917\u092f\u093e \u0939\u0948\u0964<br />\ud83d\udc49 \u0907\u0938 \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0923 \u0915\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f <strong>\u0906\u092a\u0926\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0928\u0940\u0924\u093f\u092f\u094b\u0902 \u0935 \u092f\u094b\u091c\u0928\u093e\u0913\u0902</strong> \u0915\u094b \u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0930\u0942\u092a \u0938\u0947 \u0932\u093e\u0917\u0942 \u0915\u0930\u0928\u093e \u0939\u0948\u0964<br />\ud83d\udc49 <strong>\u0906\u092a\u0926\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0905\u0927\u093f\u0928\u093f\u092f\u092e, 2005</strong> \u0915\u0947 \u092a\u094d\u0930\u093e\u0935\u0927\u093e\u0928\u094b\u0902 \u0915\u0947 \u0905\u0902\u0924\u0930\u094d\u0917\u0924 <strong>\u091c\u093f\u0932\u093e \u0915\u0932\u0947\u0915\u094d\u091f\u0930 \u0915\u094b \u091c\u093f\u0932\u093e \u0906\u092a\u0926\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0923 \u0915\u093e \u0905\u0927\u094d\u092f\u0915\u094d\u0937</strong> \u092c\u0928\u093e\u092f\u093e \u0917\u092f\u093e\u0964<br />\ud83d\udc49 \u092f\u0939 \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0923 <strong>\u0930\u093e\u091c\u094d\u092f \u0906\u092a\u0926\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0923 \u0915\u0947 \u0926\u093f\u0936\u093e-\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u094b\u0902</strong> \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u091c\u093f\u0932\u0947 \u092e\u0947\u0902 \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0924\u093e \u0939\u0948\u0964</p>\n<p class=\"P10\" style=\"border-bottom-style: none; border-style: none; border-top-style: none; color: #000000; font-family: 'Noto Sans'; font-size: 16px; margin: 0; padding: 0px; text-align: left ! important; text-decoration: none ! important; writing-mode: lr-tb;\"></p>\n<p>\u270d\ufe0f \u0938\u0939\u0940 \u0909\u0924\u094d\u0924\u0930 \u0939\u0948 &ndash; <strong>\u0906\u092a\u0926\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0905\u0927\u093f\u0928\u093f\u092f\u092e, 2005&nbsp;</strong></p>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": false, "isPartiallyCorrect": false, "isCorrect": false, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6aca54c1eefa626c6bee0b9d", "marks": {"positive": 0, "negative": 0}, "timeTaken": 0, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null, "year": "2023"}, {"_id": "68ef8da6da8f4d451619f839", "name": "<p><strong>\u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u092e\u0947\u0902 \u0938\u0947 \u0915\u093f\u0938\u0947 \u091c\u093f\u0932\u0947 \u092e\u0947\u0902 \u092a\u094d\u0930\u092e\u0941\u0916 \u091c\u0928\u0917\u0923\u0928\u093e&nbsp;\u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948 ?&nbsp;</strong></p>\n<p><span lang=\"HI\" style=\"font-size: 12.0pt; line-height: 107%; font-family: 'Noto Sans',sans-serif; mso-fareast-font-family: 'Times New Roman'; color: #00b0f0; mso-font-kerning: 0pt; mso-ligatures: none; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: HI;\">[\u0935\u094d\u092f\u093e\u0916\u094d\u092f\u093e\u0924\u093e (\u0924\u0915\u0928\u0940\u0915\u0940)&nbsp;</span><span style=\"font-size: 12.0pt; line-height: 107%; font-family: 'Noto Sans',sans-serif; mso-fareast-font-family: 'Times New Roman'; color: #00b0f0; mso-font-kerning: 0pt; mso-ligatures: none; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: HI;\">12.03.<span lang=\"HI\">20</span>21<span lang=\"HI\">]</span></span></p>", "isComprehension": false, "paragraph": null, "paragraphText": null, "fillUpsAnswers": [], "nameText": "\u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u092e\u0947\u0902 \u0938\u0947 \u0915\u093f\u0938\u0947 \u091c\u093f\u0932\u0947 \u092e\u0947\u0902 \u092a\u094d\u0930\u092e\u0941\u0916 \u091c\u0928\u0917\u0923\u0928\u093e\u00a0\u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948 ?\u00a0\n[\u0935\u094d\u092f\u093e\u0916\u094d\u092f\u093e\u0924\u093e (\u0924\u0915\u0928\u0940\u0915\u0940)\u00a012.03.2021]", "sectionId": "6a78c914c28e46199d9a4224", "order": 1, "questionSubmitOrder": 1, "options": [{"name": "<p>\u0938\u092e\u094d\u092d\u093e\u0917\u0940\u092f \u0906\u092f\u0941\u0915\u094d\u0924</p>", "nameText": "\u0938\u092e\u094d\u092d\u093e\u0917\u0940\u092f \u0906\u092f\u0941\u0915\u094d\u0924", "isCorrect": false, "_id": "66af37724d80e1279f506af7", "isMarked": false}, {"name": "<p>\u091c\u093f\u0932\u093e&nbsp;\u0915\u0932\u0947\u0915\u094d\u091f\u0930</p>", "nameText": "\u091c\u093f\u0932\u093e\u00a0\u0915\u0932\u0947\u0915\u094d\u091f\u0930", "isCorrect": true, "_id": "66af37724d80e19243506af8", "isMarked": false}, {"name": "<p>\u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u091c\u093f\u0932\u093e \u0915\u0932\u0915\u094d\u091f\u0930</p>", "nameText": "\u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u091c\u093f\u0932\u093e \u0915\u0932\u0915\u094d\u091f\u0930", "isCorrect": false, "_id": "66af37724d80e11b9a506af9", "isMarked": false}, {"name": "<p>\u0909\u092a\u0916\u0923\u094d\u0921 \u0905\u0927\u093f\u0915\u093e\u0930\u0940</p>", "nameText": "\u0909\u092a\u0916\u0923\u094d\u0921 \u0905\u0927\u093f\u0915\u093e\u0930\u0940", "isCorrect": false, "_id": "66af37724d80e12824506afa", "isMarked": false}], "solution": "<h3>\ud83d\udd39 <strong>\u0935\u094d\u092f\u093e\u0916\u094d\u092f\u093e</strong></h3>\n<p>\ud83d\udc49 <strong>\u091c\u0928\u0917\u0923\u0928\u093e \u0915\u093e\u0930\u094d\u092f</strong> \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u091c\u093f\u0932\u0947 \u092e\u0947\u0902 \u090f\u0915 <strong>\u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u092a\u094d\u0930\u0936\u093e\u0938\u0928\u093f\u0915 \u0926\u093e\u092f\u093f\u0924\u094d\u0935</strong> \u0939\u094b\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u091c\u0928\u0938\u0902\u0916\u094d\u092f\u093e, \u092a\u0930\u093f\u0935\u093e\u0930 \u090f\u0935\u0902 \u0938\u093e\u092e\u093e\u091c\u093f\u0915-\u0906\u0930\u094d\u0925\u093f\u0915 \u0906\u0901\u0915\u0921\u093c\u094b\u0902 \u0915\u093e \u0938\u0902\u0915\u0932\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964<br />\ud83d\udc49 \u0907\u0938 \u0915\u093e\u0930\u094d\u092f \u0915\u0940 \u0938\u092b\u0932\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u091c\u093f\u0932\u093e \u0938\u094d\u0924\u0930 \u092a\u0930 <strong>\u092e\u0941\u0916\u094d\u092f \u0938\u092e\u0928\u094d\u0935\u092f\u0915 \u0914\u0930 \u092a\u0930\u094d\u092f\u0935\u0947\u0915\u094d\u0937\u0915</strong> \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964<br />\ud83d\udc49 <strong>\u091c\u093f\u0932\u093e \u0915\u0932\u0947\u0915\u094d\u091f\u0930</strong> \u0915\u094b \u091c\u093f\u0932\u0947 \u0915\u093e <strong>\u092a\u094d\u0930\u092e\u0941\u0916 \u091c\u0928\u0917\u0923\u0928\u093e \u0905\u0927\u093f\u0915\u093e\u0930\u0940</strong> \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u094b \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u091c\u0928\u0917\u0923\u0928\u093e \u0915\u093e\u0930\u094d\u092f \u0915\u093e <strong>\u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0914\u0930 \u092a\u0930\u094d\u092f\u0935\u0947\u0915\u094d\u0937\u0923</strong> \u0915\u0930\u0924\u093e \u0939\u0948\u0964<br />\ud83d\udc49 \u0935\u0939 <strong>\u0938\u092d\u0940 \u0909\u092a\u0916\u0923\u094d\u0921 \u0935 \u0924\u0939\u0938\u0940\u0932 \u0905\u0927\u093f\u0915\u093e\u0930\u093f\u092f\u094b\u0902</strong> \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092f\u0939 \u0915\u093e\u0930\u094d\u092f \u0938\u0902\u092a\u0928\u094d\u0928 \u0915\u0930\u093e\u0924\u093e \u0939\u0948\u0964</p>\n<p></p>\n<p>\u270d\ufe0f \u0938\u0939\u0940 \u0909\u0924\u094d\u0924\u0930 \u0939\u0948 &ndash; <strong>\u091c\u093f\u0932\u093e \u0915\u0932\u0947\u0915\u094d\u091f\u0930&nbsp;</strong></p>", "hasMultipleAnswers": false, "type": "multiple_choice", "isAttempted": false, "isPartiallyCorrect": false, "isCorrect": false, "isGraceMarked": false, "isReevaluated": false, "isBookmark": false, "studentQuestionId": "6aca54c1eefa622ce4ee0b9e", "marks": {"positive": 0, "negative": 0}, "timeTaken": 0, "markForReview": false, "isGpscType": false, "isSurrendered": false, "difficultyLevel": null, "year": "2021"}, {"_id": "68ef8e2a36fed88aad961d7e", "name": "<p class=\"western\" style=\"margin-bottom: 0px;\"><span style=\"font-family: 'Times New Roman';\"><span lang=\"ar-SA\"><span style=\"font-family: 'Noto Sans';\"><span lang=\"hi-IN\"><strong>\u092d\u093e\u0930\u0924 \u0915\u0947 \u0938\u0902\u0935\u093f\u0927\u093e\u0928 \u0915\u0947 \u0909\u092a\u092c\u0928\u094d\u0927\u094b\u0902 \u0915\u0947 \u0905\u0928\u094d\u0924\u0930\u094d\u0917\u0924&nbsp;\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0930\u093e\u091c\u094d\u092f \u092e\u0947\u0902 \u091c\u093f\u0932\u093e \u0938\u094d\u0924\u0930 \u092a\u0930 \u090f\u0915 \u091c\u093f\u0932\u093e \u092f\u094b\u091c\u0928\u093e \u0938\u092e\u093f\u0924\u093f \u0915\u093e \u0917\u0920\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u092f\u0947\u0917\u093e </strong></span></span></span></span><span style=\"font-family: 'Noto Sans',serif;\"><strong>:</strong></span></p>\n<p class=\"western\" style=\"margin-bottom: 0px;\"><span style=\"font-family: 'Noto Sans',serif;\">(i) </span><span style=\"font-family: 'Times New Roman';\"><span lang=\"ar-SA\"><span style=\"font-family: 'Noto Sans';\"><span lang=\"hi-IN\">\u091c\u093f\u0932\u0947 \u092e\u0947\u0902 \u092a\u0902\u091a\u093e\u092f\u0924\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0924\u094