pan style=\"font-family: Calibri;\"><span lang=\"hi-IN\"><span style=\"font-family: 'Noto Sans';\">\u091c\u092f\u092a\u0941\u0930&nbsp;</span></span></span></span></p>", "nameText": "\u0926\u093f\u0932\u094d\u0932\u0940 - \u0906\u0917\u0930\u093e - \u091c\u092f\u092a\u0941\u0930\u00a0", "isCorrect": true, "_id": "66a61e9306a7cf04613ab1b8", "isMarked": false}], "solution": "<h3>\ud83d\udd39 \u0935\u094d\u092f\u093e\u0916\u094d\u092f\u093e</h3>\n<p>\ud83d\udc49 <strong>\u0917\u094b\u0932\u094d\u0921\u0928 \u091f\u094d\u0930\u093e\u090f\u0902\u0917\u0932 \u091f\u0942\u0930</strong> \u092d\u093e\u0930\u0924 \u0915\u093e \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 <strong>\u092a\u0930\u094d\u092f\u091f\u0928 \u0938\u0930\u094d\u0915\u093f\u091f</strong> \u0939\u0948\u0964<br />\ud83d\udc49 \u0907\u0938\u092e\u0947\u0902 <strong>\u0926\u093f\u0932\u094d\u0932\u0940, \u0906\u0917\u0930\u093e \u0914\u0930 \u091c\u092f\u092a\u0941\u0930</strong> \u0924\u0940\u0928 \u092a\u094d\u0930\u092e\u0941\u0916 \u0936\u0939\u0930 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902\u0964<br />\ud83d\udc49 <strong>\u0926\u093f\u0932\u094d\u0932\u0940</strong> \u0906\u0927\u0941\u0928\u093f\u0915 \u0935 \u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u092d\u093e\u0930\u0924 \u0915\u093e \u0938\u0902\u0917\u092e \u0939\u0948\u0964<br />\ud83d\udc49 <strong>\u0906\u0917\u0930\u093e</strong> \u0905\u092a\u0928\u0947 <strong>\u0924\u093e\u091c\u092e\u0939\u0932</strong> \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0939\u0948, \u091c\u092c\u0915\u093f <strong>\u091c\u092f\u092a\u0941\u0930</strong> <strong>&lsquo;\u0917\u0941\u0932\u093e\u092c\u0940 \u0936\u0939\u0930&rsquo;</strong> \u0915\u0939\u0932\u093e\u0924\u093e \u0939\u0948\u0964</p>\n<p></p>\n<p>\u270d\ufe0f \u0938\u0939\u0940 \u0909\u0924\u094d\u0924\u0930 \u0939\u0948 &ndash; <strong>\u0926\u093f\u0932\u094d\u0932\u0940, \u0906\u0917\u0930\u093e \u0914\u0930 \u091c\u092f\u092a\u0941\u0930&